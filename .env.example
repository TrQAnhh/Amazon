# =======================
# API Gateway
# =======================
API_GATEWAY_PORT=3000  # Port for the API Gateway service

# =======================
# Identity Service
# =======================
IDENTITY_SERVICE_HOST=identity          # Hostname for Identity Service
IDENTITY_SERVICE_PORT=4001              # Port for Identity Service

# Identity Service Database
MYSQL_IDENTITY_HOST=localhost            # Database host
MYSQL_IDENTITY_PORT=3306                 # Database port
MYSQL_IDENTITY_DATABASE=YOUR_DB_NAME    # Database name
MYSQL_IDENTITY_USER=YOUR_DB_USER        # Database username
MYSQL_IDENTITY_PASSWORD=YOUR_DB_PASS    # Database password

# =======================
# Product Service
# =======================
PRODUCT_SERVICE_HOST=product            # Hostname for Product Service
PRODUCT_SERVICE_PORT=4002               # Port for Product Service

# Product Service Database
MYSQL_PRODUCT_HOST=localhost
MYSQL_PRODUCT_PORT=3306
MYSQL_PRODUCT_DATABASE=YOUR_DB_NAME
MYSQL_PRODUCT_USER=YOUR_DB_USER
MYSQL_PRODUCT_PASSWORD=YOUR_DB_PASS

# =======================
# Profile Service
# =======================
PROFILE_SERVICE_HOST=profile
PROFILE_SERVICE_PORT=4003

# Profile Service Database
MYSQL_PROFILE_HOST=localhost
MYSQL_PROFILE_PORT=3306
MYSQL_PROFILE_DATABASE=YOUR_DB_NAME
MYSQL_PROFILE_USER=YOUR_DB_USER
MYSQL_PROFILE_PASSWORD=YOUR_DB_PASS

# =======================
# Order Service
# =======================
ORDER_SERVICE_HOST=order
ORDER_SERVICE_PORT=4004

# Order Service Database
MYSQL_ORDER_HOST=localhost
MYSQL_ORDER_PORT=3306
MYSQL_ORDER_DATABASE=YOUR_DB_NAME
MYSQL_ORDER_USER=YOUR_DB_USER
MYSQL_ORDER_PASSWORD=YOUR_DB_PASS

# =======================
# Cloudinary (Avatar Uploads)
# =======================
CLOUDINARY_NAME=YOUR_CLOUD_NAME        # Your Cloudinary cloud name
CLOUDINARY_API_KEY=YOUR_API_KEY        # Cloudinary API key
CLOUDINARY_API_SECRET=YOUR_API_SECRET  # Cloudinary API secret

# =======================
# Redis (Caching & Redlock)
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ACCESS_KEY=YOUR_REDIS_PASSWORD   # Optional password for Redis

# =======================
# Stripe (Payments)
# =======================
STRIPE_API_KEY=YOUR_STRIPE_API_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
SUCCESSFUL_URL=http://localhost:5173/checkout/success
CANCEL_URL=http://localhost:5173/checkout/failed

# =======================
# JWT (Authentication)
# =======================
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ACCESS_TOKEN_DURATION=30m          # Access token expiry
JWT_REFRESH_TOKEN_DURATION=7d          # Refresh token expiry

# =======================
# Redlock (Distributed Locks)
# =======================
REDLOCK_RETRY_COUNT=5
REDLOCK_RETRY_DELAY=1000               # Delay between retries in ms
REDLOCK_RETRY_JITTER=50                # Random jitter in ms
REDLOCK_TTL=30000                       # Lock expiration in ms

# =======================
# Email (SMTP)
# =======================
EMAIL_HOST=YOUR_SMTP_HOST
EMAIL_PORT=587
EMAIL_USER=YOUR_EMAIL_ADDRESS
EMAIL_PASS=YOUR_EMAIL_PASSWORD

# =======================
# Email Verification
# =======================
VERIFY_EMAIL_URL=http://localhost:5173/confirm
SHORT_RATE_LIMIT_TTL=60s               # Minimum interval between resend emails
LONG_RATE_LIMIT_TTL=30m                # Global resend rate limit
VERIFY_EMAIL_TOKEN_DURATION=72h        # Verification token expiry
